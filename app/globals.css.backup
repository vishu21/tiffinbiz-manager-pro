@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

/* ─────────────────────────────────────────────────────────────────────────
   KITCHEN PRINT SHEET — dedicated print styles for the /prep dashboard
   ("Kitchen Packing Manifest", PrepDashboardClient). The JSX pairs these
   rules with Tailwind `print:` variants; everything below is scoped to the
   `.print-sheet` region so the other dashboards stay untouched.
   ───────────────────────────────────────────────────────────────────────── */
@media print {
  html,
  body {
    height: auto !important;
    overflow: visible !important;
    background: #fff !important;
    color: #000 !important;
  }

  /* Kill interactive chrome (card/drop shadows never print cleanly) and force
     high-contrast ink for every manifest cell/badge. */
  .print-sheet,
  .print-sheet * {
    box-shadow: none !important;
  }
  .print-sheet th,
  .print-sheet td,
  .print-sheet td span,
  .print-sheet td div {
    color: #000 !important;
  }

  /* Never split a customer row across printed pages. */
  .print-sheet tbody tr {
    page-break-inside: avoid;
    break-inside: avoid;
  }

  /* Repeat the column headers at the top of every printed page. */
  .print-sheet thead {
    display: table-header-group;
  }

  /* Compact print density — one place for what would otherwise be repeated
     `print:py-1 print:px-1.5 print:text-[11px]` on every manifest cell. Release
     the screen row height so cell padding controls printed row height, and allow
     soft-wrapping (full addresses / multi-line notes) without clipping. */
  .print-sheet thead th,
  .print-sheet tbody td {
    padding: 0.25rem 0.375rem !important;
    vertical-align: middle;
  }
  .print-sheet thead th {
    font-size: 10px !important;
  }
  .print-sheet tbody td,
  .print-sheet tbody td span,
  .print-sheet tbody td div {
    font-size: 11px !important;
  }
  .print-sheet tbody td {
    white-space: normal !important;
  }
  .print-sheet tbody tr {
    height: auto !important;
  }
}
